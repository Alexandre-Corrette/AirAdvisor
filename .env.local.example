# Copier ce fichier en .env.local et remplir les vraies valeurs
# NE JAMAIS committer .env.local sur git

APP_SECRET=generate_with_symfony_secret_generate

# Production DB (PostgreSQL Supabase)
# DATABASE_URL="postgresql://user:password@host:5432/dbname?serverVersion=15&charset=utf8"

# Dev SQLite (déjà dans .env par défaut)
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"

# Mailer
# MAILER_DSN=smtp://user:pass@smtp.example.com:587

# API Aviation Edge (optionnel)
# AVIATION_EDGE_API_KEY=your_key_here

# Skyscanner Affiliate
# SKYSCANNER_PARTNER_ID=your_partner_id

# Booking.com Affiliate
# BOOKING_AFFILIATE_ID=your_affiliate_id
