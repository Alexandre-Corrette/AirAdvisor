{% extends "base.html.twig" %}

{% block title %}Tableau de bord — {{ account.companyName }}{% endblock %}

{% block body %}
<div class="max-w-5xl mx-auto px-4 py-10">
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-3xl font-extrabold text-gray-900">Tableau de bord</h1>
            <p class="text-gray-500">{{ account.companyName }}{% if account.verified %} <span class="inline-flex items-center gap-1 bg-blue-100 text-blue-700 text-xs font-semibold px-2 py-0.5 rounded-full ml-2">Verifie</span>{% endif %}</p>
        </div>
        <a href="{{ path('airline_logout') }}" class="text-sm text-gray-500 hover:text-red-600 transition">Deconnexion</a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="bg-green-50 border border-green-200 text-green-800 rounded-lg p-4 mb-6">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('info') %}
        <div class="bg-blue-50 border border-blue-200 text-blue-800 rounded-lg p-4 mb-6">{{ message }}</div>
    {% endfor %}

    {% if account.stripeAccountId and not account.verified %}
        <div class="bg-orange-50 border border-orange-200 rounded-xl p-6 mb-6">
            <h2 class="text-lg font-bold text-orange-800 mb-2">Verification en cours</h2>
            <p class="text-orange-700 text-sm mb-4">
                Pour activer votre page compagnie et obtenir le badge verifie, veuillez completer la verification de votre entreprise via Stripe.
            </p>
            {% if onboardingUrl %}
                <a href="{{ onboardingUrl }}"
                   class="inline-flex items-center px-4 py-2 bg-orange-600 text-white text-sm font-semibold rounded-lg hover:bg-orange-700 transition">
                    Completer la verification
                </a>
            {% endif %}
        </div>
    {% endif %}

    {% if account.airline %}
        <div class="bg-white rounded-xl shadow-sm p-8 mb-6">
            <h2 class="text-lg font-bold text-gray-900 mb-4">Votre compagnie</h2>
            <div class="flex items-center gap-4">
                {% if account.airline.logoUrl %}
                    <img src="{{ account.airline.logoUrl }}" alt="{{ account.airline.name }}" class="h-12 object-contain">
                {% endif %}
                <div>
                    <p class="font-semibold text-gray-900">{{ account.airline.name }}</p>
                    <p class="text-sm text-gray-500">{{ account.airline.iataCode }}{% if account.airline.country %} — {{ account.airline.country }}{% endif %}</p>
                </div>
                <a href="{{ path('app_airline_show', {slug: account.airline.slug}) }}" class="ml-auto text-blue-600 hover:underline text-sm">Voir la page publique</a>
            </div>
        </div>
    {% else %}
        <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-6 mb-6">
            <p class="text-yellow-800">Votre compte n'est pas encore lie a une compagnie. Un administrateur va traiter votre demande.</p>
        </div>
    {% endif %}

    <div class="bg-white rounded-xl shadow-sm p-8">
        <h2 class="text-lg font-bold text-gray-900 mb-4">Fonctionnalites a venir</h2>
        <ul class="space-y-2 text-gray-600 text-sm">
            <li>Repondre aux avis des passagers</li>
            <li>Consulter vos statistiques detaillees</li>
            <li>Modifier les informations de votre page</li>
        </ul>
    </div>
</div>
{% endblock %}
