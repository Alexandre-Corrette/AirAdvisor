{% extends "base.html.twig" %}

{% block title %}Avis vol {{ flight.flightNumber }} {{ flight.flightDate|date('Y-m-d') }} — AirAdvisor{% endblock %}
{% block meta_description %}Consultez les {{ reviewCount }} avis des passagers du vol {{ flight.flightNumber }} ({{ flight.departureCity }} → {{ flight.arrivalCity }}) du {{ flight.flightDate|date('d/m/Y') }}.{% endblock %}

{% block body %}
<div class="max-w-5xl mx-auto px-4 py-10">
    {# Flash messages #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="mb-4 p-4 rounded-lg text-sm
                {% if label == 'success' %}bg-green-50 text-green-800 border border-green-200
                {% elseif label == 'warning' %}bg-yellow-50 text-yellow-800 border border-yellow-200
                {% else %}bg-red-50 text-red-800 border border-red-200{% endif %}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    {# Breadcrumb #}
    <nav class="text-sm text-gray-500 mb-6">
        <a href="{{ path('app_home') }}" class="hover:text-blue-600 transition">Accueil</a>
        <span class="mx-1">/</span>
        <a href="{{ path('app_search', {q: flight.flightNumber}) }}" class="hover:text-blue-600 transition">Recherche</a>
        <span class="mx-1">/</span>
        <span class="text-gray-900">{{ flight.flightNumber }}</span>
    </nav>

    {# Header vol #}
    <div class="bg-white rounded-xl shadow-sm p-8 mb-8">
        <div class="flex flex-wrap items-start justify-between gap-6">
            <div>
                <div class="flex items-center gap-3 mb-2">
                    {% if flight.airline %}
                        {% if flight.airline.logoUrl %}
                            <img src="{{ flight.airline.logoUrl }}" alt="{{ flight.airline.name }}" class="h-8 object-contain">
                        {% endif %}
                        <span class="text-gray-600">{{ flight.airline.name }}</span>
                    {% endif %}
                </div>
                <h1 class="text-3xl font-extrabold text-gray-900 mb-2">Vol {{ flight.flightNumber }}</h1>
                <p class="text-lg text-gray-600">
                    {{ flight.departureCity }}{% if flight.departureIataCode %} ({{ flight.departureIataCode }}){% endif %}
                    →
                    {{ flight.arrivalCity }}{% if flight.arrivalIataCode %} ({{ flight.arrivalIataCode }}){% endif %}
                </p>
                <p class="text-sm text-gray-500 mt-1">{{ flight.flightDate|date('d/m/Y') }}
                    {% if flight.scheduledDepartureTime %} · Départ {{ flight.scheduledDepartureTime|date('H:i') }}{% endif %}
                    {% if flight.scheduledArrivalTime %} · Arrivée {{ flight.scheduledArrivalTime|date('H:i') }}{% endif %}
                </p>
            </div>
            <div class="text-right">
                {% if flight.status %}
                    {% set statusColors = {
                        'on_time': 'bg-green-100 text-green-800',
                        'landed': 'bg-green-100 text-green-800',
                        'delayed': 'bg-yellow-100 text-yellow-800',
                        'cancelled': 'bg-red-100 text-red-800',
                        'scheduled': 'bg-blue-100 text-blue-800'
                    } %}
                    {% set statusLabels = {
                        'on_time': 'À l\'heure',
                        'landed': 'Atterri',
                        'delayed': 'Retardé',
                        'cancelled': 'Annulé',
                        'scheduled': 'Programmé'
                    } %}
                    <span class="inline-block px-3 py-1 rounded-full text-sm font-medium {{ statusColors[flight.status] ?? 'bg-gray-100 text-gray-800' }}">
                        {{ statusLabels[flight.status] ?? flight.status }}
                    </span>
                {% endif %}
            </div>
        </div>
    </div>

    {# Note globale + sous-critères #}
    <div class="bg-white rounded-xl shadow-sm p-8 mb-8">
        <div class="flex flex-wrap items-center gap-10">
            {# Note globale #}
            <div class="text-center">
                {% if reviewCount > 0 %}
                    <div class="text-5xl font-extrabold text-blue-600">{{ avgRating|number_format(1, ',') }}</div>
                    <div class="text-yellow-500 text-2xl mt-1">
                        {% set rounded = avgRating|round(0, 'floor') %}
                        {% for i in 1..5 %}{% if i <= rounded %}★{% else %}☆{% endif %}{% endfor %}
                    </div>
                    <p class="text-sm text-gray-500 mt-1">{{ reviewCount }} avis</p>
                {% else %}
                    <p class="text-gray-400">Aucun avis</p>
                {% endif %}
            </div>

            {# Sous-critères #}
            {% if reviewCount > 0 %}
            <div class="flex-1 space-y-3 min-w-[250px]">
                {% set criteria = [
                    {label: 'Confort', value: avgComfort},
                    {label: 'Ponctualité', value: avgPunctuality},
                    {label: 'Personnel', value: avgStaff},
                    {label: 'Nourriture', value: avgFood}
                ] %}
                {% for criterion in criteria %}
                    {% if criterion.value is not null %}
                    <div class="flex items-center gap-3">
                        <span class="text-sm text-gray-600 w-24">{{ criterion.label }}</span>
                        <div class="flex-1 bg-gray-200 rounded-full h-2.5">
                            <div class="bg-blue-600 h-2.5 rounded-full" style="width: {{ (criterion.value / 5 * 100)|round }}%"></div>
                        </div>
                        <span class="text-sm font-medium text-gray-700 w-8">{{ criterion.value|number_format(1, ',') }}</span>
                    </div>
                    {% endif %}
                {% endfor %}
            </div>
            {% endif %}
        </div>
    </div>

    {# Bouton avis #}
    {% if is_granted('ROLE_USER') %}
        <div class="mb-8">
            <a href="{{ path('app_review_new', {flightNumber: flight.flightNumber, date: flight.flightDate|date('Y-m-d')}) }}"
               class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-3 rounded-lg transition">
                Donner mon avis
            </a>
        </div>
    {% endif %}

    {# Liste des avis #}
    {% if reviewCount > 0 %}
    <section>
        <h2 class="text-xl font-bold text-gray-900 mb-6">Avis des passagers</h2>
        <div class="space-y-4">
            {% for review in flight.reviews %}
            <div class="bg-white rounded-xl shadow-sm p-6">
                <div class="flex items-start gap-4">
                    {# Avatar initiales #}
                    <div class="w-10 h-10 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-sm shrink-0">
                        {{ review.author.pseudo|first|upper }}
                    </div>
                    <div class="flex-1">
                        <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                            <div>
                                <span class="font-semibold text-gray-900">{{ review.author.pseudo }}</span>
                                <span class="text-xs text-gray-400 ml-2">{{ review.createdAt|date('d/m/Y') }}</span>
                            </div>
                            <span class="text-yellow-500">
                                {% for i in 1..5 %}{% if i <= review.rating %}★{% else %}☆{% endif %}{% endfor %}
                            </span>
                        </div>
                        <h3 class="font-medium text-gray-900 mb-1">{{ review.title }}</h3>
                        <p class="text-sm text-gray-600">{{ review.content }}</p>
                        {% if app.user and app.user == review.author %}
                            <div class="flex items-center gap-3 mt-3 pt-3 border-t border-gray-100">
                                <a href="{{ path('app_review_edit', {id: review.id}) }}" class="text-sm text-blue-600 hover:text-blue-700 font-medium transition">Modifier</a>
                                <form method="post" action="{{ path('app_review_delete', {id: review.id}) }}" onsubmit="return confirm('Supprimer cet avis ?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete-review-' ~ review.id) }}">
                                    <button type="submit" class="text-sm text-red-600 hover:text-red-700 font-medium transition">Supprimer</button>
                                </form>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </section>
    {% endif %}
</div>
{% endblock %}
