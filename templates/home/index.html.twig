{% extends "base.html.twig" %}

{% block title %}AirAdvisor — Avis sur vos vols{% endblock %}
{% block meta_description %}AirAdvisor : consultez les avis de passagers sur les vols et compagnies aériennes. Trouvez la meilleure compagnie pour votre prochain voyage.{% endblock %}
{% block og_title %}AirAdvisor — Avis sur vos vols{% endblock %}
{% block og_description %}AirAdvisor : consultez les avis de passagers sur les vols et compagnies aériennes. Trouvez la meilleure compagnie pour votre prochain voyage.{% endblock %}

{% block body %}
{# Hero — immersif avec overlay #}
<section class="relative h-[560px] flex items-center justify-center overflow-hidden">
    <img src="https://images.unsplash.com/photo-1436491865332-7a61a109cc05?w=1600&q=80&auto=format&fit=crop"
         alt="Avion en vol"
         class="absolute inset-0 w-full h-full object-cover">
    <div class="absolute inset-0 bg-slate-900/60"></div>
    <div class="relative z-10 text-center text-white px-4 max-w-3xl mx-auto">
        <h1 class="text-5xl md:text-6xl font-extrabold mb-4 drop-shadow-lg">
            Votre vol, votre avis.
        </h1>
        <p class="text-lg md:text-xl text-slate-200 mb-8 drop-shadow">
            Consultez des milliers d'avis de passagers et trouvez la meilleure compagnie pour votre prochain voyage.
        </p>
        <form action="{{ path('app_search') }}" method="GET"
              class="flex flex-col sm:flex-row gap-2 max-w-2xl mx-auto bg-white/10 backdrop-blur-sm p-2 rounded-2xl border border-white/20">
            <input type="text" name="q"
                   placeholder="Vol, compagnie, ville de départ ou d'arrivée…"
                   class="flex-1 bg-white text-gray-900 placeholder-gray-400 px-5 py-3 rounded-xl focus:outline-none focus:ring-2 focus:ring-yellow-400 text-sm">
            <button type="submit"
                    class="bg-yellow-500 hover:bg-yellow-400 text-slate-900 font-bold px-8 py-3 rounded-xl transition flex items-center justify-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
                Rechercher
            </button>
        </form>
    </div>
</section>

{# Stats bar #}
<section class="bg-white border-b shadow-sm">
    <div class="max-w-5xl mx-auto px-4 py-4 flex flex-wrap justify-center gap-8 text-center">
        <div>
            <span class="text-2xl font-bold text-slate-900">{{ totalReviews }}</span>
            <p class="text-xs text-slate-500 uppercase tracking-wide mt-1">Avis de passagers</p>
        </div>
        <div>
            <span class="text-2xl font-bold text-slate-900">{{ totalFlights }}</span>
            <p class="text-xs text-slate-500 uppercase tracking-wide mt-1">Vols notés</p>
        </div>
        <div>
            <span class="text-2xl font-bold text-slate-900">{{ totalAirlines }}</span>
            <p class="text-xs text-slate-500 uppercase tracking-wide mt-1">Compagnies</p>
        </div>
    </div>
</section>

{# Derniers avis #}
{% if latestReviews is not empty %}
<section class="max-w-7xl mx-auto px-4 py-16">
    <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl font-bold text-slate-900">Derniers avis</h2>
        <a href="{{ path('app_search') }}" class="text-sm text-blue-600 hover:text-blue-700 font-medium">Voir tous les vols →</a>
    </div>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {% for review in latestReviews %}
        <a href="{{ path('app_flight_show', {flightNumber: review.flight.flightNumber, date: review.flight.flightDate|date('Y-m-d')}) }}"
           class="group block bg-white rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden">
            {# Header coloré selon la note #}
            <div class="px-5 py-3 flex items-center justify-between
                {% if review.rating >= 5 %}
                    bg-gradient-to-r from-green-500 to-slate-700
                {% elseif review.rating >= 4 %}
                    bg-gradient-to-r from-blue-500 to-slate-700
                {% elseif review.rating >= 3 %}
                    bg-gradient-to-r from-yellow-500 to-slate-700
                {% else %}
                    bg-gradient-to-r from-red-500 to-slate-700
                {% endif %}
            ">
                <span class="text-white font-semibold text-sm">{{ review.flight.airline.name }}</span>
                <span class="text-white font-bold">{{ review.flight.departureCity|slice(0,3)|upper }} → {{ review.flight.arrivalCity|slice(0,3)|upper }}</span>
            </div>
            {# Body #}
            <div class="p-5">
                <div class="flex items-center gap-1 mb-2">
                    {% for i in 1..5 %}
                    <svg class="w-4 h-4 {{ i <= review.rating ? 'text-yellow-400' : 'text-gray-200' }}" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                    {% endfor %}
                    <span class="text-sm text-slate-500 ml-1">{{ review.rating }}/5</span>
                </div>
                <h3 class="font-semibold text-slate-900 mb-2 line-clamp-1">{{ review.title }}</h3>
                <p class="text-sm text-slate-600 line-clamp-2 mb-4">{{ review.content }}</p>
                <div class="flex items-center justify-between text-xs text-slate-400">
                    <span class="flex items-center gap-1">
                        <span class="w-6 h-6 rounded-full bg-slate-200 flex items-center justify-center font-bold text-slate-600 text-xs">{{ review.author.pseudo|first|upper }}</span>
                        {{ review.author.pseudo ?? review.author.firstName }}
                    </span>
                    <span>{{ review.createdAt|date("d/m/Y") }}</span>
                </div>
            </div>
        </a>
        {% endfor %}
    </div>
</section>
{% endif %}

{# Compagnies populaires #}
{% if topAirlines is not empty %}
<section class="bg-slate-50 py-16">
    <div class="max-w-7xl mx-auto px-4">
        <h2 class="text-2xl font-bold text-slate-900 mb-8">Compagnies populaires</h2>
        <div class="grid gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5">
            {% for row in topAirlines %}
            {% set airline = row[0] %}
            <a href="{{ path('app_airline_show', {slug: airline.slug}) }}"
               class="bg-white rounded-2xl p-6 text-center shadow-sm hover:shadow-lg transition-all duration-300 group">
                <div class="h-14 flex items-center justify-center mb-3">
                    {% if airline.logoUrl %}
                        <img src="{{ airline.logoUrl }}" alt="{{ airline.name }}" class="max-h-12 object-contain">
                    {% else %}
                        <span class="text-3xl font-extrabold text-slate-200 group-hover:text-yellow-400 transition">{{ airline.iataCode }}</span>
                    {% endif %}
                </div>
                <h3 class="font-semibold text-slate-900 text-sm mb-2">{{ airline.name }}</h3>
                <div class="inline-flex items-center gap-1 bg-yellow-50 px-2 py-1 rounded-full">
                    <svg class="w-3 h-3 text-yellow-500" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                    <span class="text-xs font-bold text-yellow-700">{{ row.avgRating|number_format(1, ',') }}</span>
                    <span class="text-xs text-slate-400">({{ row.reviewCount }})</span>
                </div>
            </a>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

{# CTA final #}
<section class="bg-slate-900 text-white py-16">
    <div class="max-w-3xl mx-auto px-4 text-center">
        <h2 class="text-3xl font-bold mb-4">Vous avez pris un vol récemment ?</h2>
        <p class="text-slate-400 mb-8">Partagez votre expérience et aidez des milliers de voyageurs à faire le bon choix.</p>
        {% if app.user %}
            <a href="{{ path('app_search') }}" class="inline-block bg-yellow-500 hover:bg-yellow-400 text-slate-900 font-bold px-8 py-4 rounded-xl transition text-lg">Trouver mon vol →</a>
        {% else %}
            <a href="{{ path('app_register') }}" class="inline-block bg-yellow-500 hover:bg-yellow-400 text-slate-900 font-bold px-8 py-4 rounded-xl transition text-lg">Créer un compte gratuitement →</a>
        {% endif %}
    </div>
</section>
{% endblock %}
