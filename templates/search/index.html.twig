{% extends "base.html.twig" %}

{% block title %}{% if query %}Recherche « {{ query }} » — {% endif %}AirAdvisor{% endblock %}
{% block meta_description %}Recherchez un vol, une compagnie ou une ville sur AirAdvisor.{% endblock %}
{% block og_title %}{% if query %}Recherche « {{ query }} » — {% endif %}AirAdvisor{% endblock %}
{% block og_description %}Recherchez un vol, une compagnie ou une ville sur AirAdvisor.{% endblock %}

{% block body %}
<div class="max-w-5xl mx-auto px-4 py-10">
    {# Breadcrumb #}
    <nav class="text-sm text-gray-500 mb-6">
        <a href="{{ path('app_home') }}" class="hover:text-blue-600 transition">Accueil</a>
        <span class="mx-1">/</span>
        <span class="text-gray-900">Recherche</span>
    </nav>

    {# Barre de recherche #}
    <form action="{{ path('app_search') }}" method="GET" class="flex mb-8">
        <input type="text" name="q" value="{{ query }}" placeholder="Rechercher un vol, une compagnie, une ville…"
               class="flex-1 px-5 py-3 border border-gray-300 rounded-l-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
        <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-3 rounded-r-lg transition">
            Rechercher
        </button>
    </form>

    {% if query %}
        <p class="text-sm text-gray-500 mb-6">{{ total }} résultat{{ total > 1 ? 's' : '' }} pour « <strong>{{ query }}</strong> »</p>
    {% endif %}

    {# Résultats #}
    {% if results is not empty %}
        <div class="space-y-4">
            {% for row in results %}
                {% set flight = row[0] %}
                {% set reviewCount = row.reviewCount %}
                {% set avgRating = row.avgRating %}
            <a href="{{ path('app_flight_show', {flightNumber: flight.flightNumber, date: flight.flightDate|date('Y-m-d')}) }}"
               class="block bg-white rounded-lg shadow-sm hover:shadow-md transition p-5">
                <div class="flex flex-wrap items-center justify-between gap-4">
                    <div>
                        <span class="font-bold text-blue-600">{{ flight.flightNumber }}</span>
                        {% if flight.airline %}
                            <span class="text-gray-500 ml-2">{{ flight.airline.name }}</span>
                        {% endif %}
                    </div>
                    <div class="text-sm text-gray-600">
                        {{ flight.departureCity }} → {{ flight.arrivalCity }}
                    </div>
                    <div class="text-sm text-gray-500">
                        {{ flight.flightDate|date('d/m/Y') }}
                    </div>
                    <div class="text-sm">
                        {% if reviewCount > 0 %}
                            <span class="text-yellow-500">★ {{ avgRating|number_format(1, ',') }}</span>
                            <span class="text-gray-400 ml-1">({{ reviewCount }})</span>
                        {% else %}
                            <span class="text-gray-400">Aucun avis</span>
                        {% endif %}
                    </div>
                </div>
            </a>
            {% endfor %}
        </div>

        {# Pagination #}
        {% if totalPages > 1 %}
        <nav class="flex justify-center gap-2 mt-10">
            {% if page > 1 %}
                <a href="{{ path('app_search', {q: query, page: page - 1}) }}" class="px-4 py-2 bg-white border rounded-lg hover:bg-gray-50 transition text-sm">Précédent</a>
            {% endif %}
            {% for p in 1..totalPages %}
                {% if p == page %}
                    <span class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm">{{ p }}</span>
                {% else %}
                    <a href="{{ path('app_search', {q: query, page: p}) }}" class="px-4 py-2 bg-white border rounded-lg hover:bg-gray-50 transition text-sm">{{ p }}</a>
                {% endif %}
            {% endfor %}
            {% if page < totalPages %}
                <a href="{{ path('app_search', {q: query, page: page + 1}) }}" class="px-4 py-2 bg-white border rounded-lg hover:bg-gray-50 transition text-sm">Suivant</a>
            {% endif %}
        </nav>
        {% endif %}
    {% elseif query %}
        <div class="text-center py-16">
            <p class="text-gray-500 text-lg">Aucun résultat pour « <strong>{{ query }}</strong> »</p>
            <p class="text-sm text-gray-400 mt-2">Essayez avec un autre numéro de vol, une ville ou une compagnie.</p>
        </div>
    {% else %}
        <div class="text-center py-16">
            <p class="text-gray-500 text-lg">Entrez un terme de recherche pour trouver des vols.</p>
        </div>
    {% endif %}
</div>
{% endblock %}
