<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}AirAdvisor{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}Avis et notes sur les vols. Trouvez la meilleure compagnie pour votre prochain voyage.{% endblock %}">
    <link rel="canonical" href="{{ app.request.uri }}">
    {% block og_tags %}
    <meta property="og:title" content="{% block og_title %}AirAdvisor{% endblock %}">
    <meta property="og:description" content="{% block og_description %}Avis et notes sur les vols. Trouvez la meilleure compagnie pour votre prochain voyage.{% endblock %}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ app.request.uri }}">
    <meta name="twitter:card" content="summary">
    {% endblock %}
    {% block stylesheets %}
    {% endblock %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="bg-white text-gray-900">
    {% block navbar %}
    <nav class="bg-slate-900 text-white shadow-lg">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <a href="{{ path('app_home') }}" class="flex items-center gap-2 text-xl font-bold text-white hover:text-yellow-400 transition">
                    <span class="text-2xl">✈</span>
                    <span>Air<span class="text-yellow-400">Advisor</span></span>
                </a>
                <div class="hidden md:flex items-center gap-6">
                    <a href="{{ path('app_airline_index') }}" class="text-sm text-slate-300 hover:text-white transition font-medium">Compagnies</a>
                    <a href="{{ path('app_search') }}" class="text-sm text-slate-300 hover:text-white transition font-medium">Rechercher un vol</a>
                    {% if app.user %}
                        {% if app.user.roles is defined and 'ROLE_AIRLINE' in app.user.roles %}
                            <a href="{{ path('airline_dashboard') }}" class="text-sm text-slate-300 hover:text-white transition">{{ app.user.companyName }}</a>
                            <a href="{{ path('airline_logout') }}" class="text-sm bg-slate-700 hover:bg-slate-600 text-white px-4 py-2 rounded-lg transition">Déconnexion</a>
                        {% else %}
                            <a href="{{ path('app_profile') }}" class="text-sm text-slate-300 hover:text-white transition">{{ app.user.pseudo ?? app.user.firstName }}</a>
                            <a href="{{ path('app_logout') }}" class="text-sm bg-slate-700 hover:bg-slate-600 text-white px-4 py-2 rounded-lg transition">Déconnexion</a>
                        {% endif %}
                    {% else %}
                        <a href="{{ path('app_login') }}" class="text-sm text-slate-300 hover:text-white transition">Connexion</a>
                        <a href="{{ path('app_register') }}" class="text-sm bg-yellow-500 hover:bg-yellow-400 text-slate-900 font-semibold px-4 py-2 rounded-lg transition">S'inscrire</a>
                    {% endif %}
                </div>
            </div>
        </div>
    </nav>
    {% endblock %}
    <main>{% block body %}{% endblock %}</main>
    {% block ads %}{% endblock %}
    {% block footer %}
    <footer class="bg-slate-900 text-slate-400 mt-16">
        <div class="max-w-7xl mx-auto px-4 py-12 grid grid-cols-1 md:grid-cols-3 gap-8">
            <div>
                <div class="text-white font-bold text-lg mb-3">✈ Air<span class="text-yellow-400">Advisor</span></div>
                <p class="text-sm">La communauté de passagers qui note et compare les vols.</p>
            </div>
            <div>
                <h4 class="text-white font-semibold mb-3">Explorer</h4>
                <ul class="space-y-2 text-sm">
                    <li><a href="{{ path('app_airline_index') }}" class="hover:text-white transition">Compagnies aériennes</a></li>
                    <li><a href="{{ path('app_search') }}" class="hover:text-white transition">Rechercher un vol</a></li>
                </ul>
            </div>
            <div>
                <h4 class="text-white font-semibold mb-3">Compte</h4>
                <ul class="space-y-2 text-sm">
                    <li><a href="{{ path('app_login') }}" class="hover:text-white transition">Connexion</a></li>
                    <li><a href="{{ path('app_register') }}" class="hover:text-white transition">Inscription</a></li>
                </ul>
            </div>
        </div>
        <div class="border-t border-slate-800 text-center py-4 text-xs">
            © {{ "now"|date("Y") }} AirAdvisor — Tous droits réservés
        </div>
    </footer>
    {% endblock %}
</body>
</html>
