<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}AirAdvisor{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}Avis et notes sur les vols. Trouvez la meilleure compagnie pour votre prochain voyage.{% endblock %}">
    {% block stylesheets %}
    {% endblock %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="bg-gray-50 text-gray-900">
    {% block navbar %}
    <nav class="bg-white shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <a href="{{ path('app_home') }}" class="text-xl font-bold text-blue-600 hover:text-blue-700 transition">
                    AirAdvisor
                </a>
                <div class="flex items-center gap-4">
                    <a href="{{ path('app_airline_index') }}" class="text-sm text-gray-600 hover:text-gray-900 transition">Compagnies</a>
                    <a href="{{ path('app_search') }}" class="text-sm text-gray-600 hover:text-gray-900 transition">Recherche</a>
                    {% if app.user %}
                        <a href="{{ path('app_profile') }}" class="text-sm text-gray-700 font-medium hover:text-blue-600 transition">{{ app.user.pseudo ?? app.user.firstName }}</a>
                        <a href="{{ path('app_logout') }}" class="text-sm text-gray-500 hover:text-gray-700 transition">Déconnexion</a>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="text-sm text-gray-600 hover:text-gray-900 transition">Connexion</a>
                        <a href="{{ path('app_register') }}" class="text-sm bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition">Inscription</a>
                    {% endif %}
                </div>
            </div>
        </div>
    </nav>
    {% endblock %}
    <main>{% block body %}{% endblock %}</main>
    {% block footer %}{% endblock %}
</body>
</html>
